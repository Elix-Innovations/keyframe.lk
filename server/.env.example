# Copy to server/.env and fill in what you have.

# Port for the API server (the web dev server proxies /api to 8787)
PORT=8787

# Transcription — at least one is required. ElevenLabs Scribe is much better for Sinhala.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=scribe_v1
OPENAI_API_KEY=

# AI features (emphasis, hooks, descriptions, proofreading, B-roll planning, music mood) use Claude when
# either of these is set, otherwise Gemini (GEMINI_API_KEY below). Either Anthropic variable works.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Optional: explicit ffmpeg / ffprobe binaries (defaults: resolved from PATH)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Google Gemini transcription (good Sinhala; used when ElevenLabs is not set)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Gemini's word times drift, so each word is re-timed from the audio by the forced aligner in the Python
# service (run `npm run align:fetch` once to download its ~1.2 GB model). Without it, Gemini's times are used.
# SINHALA_SERVICE_URL=http://localhost:8788
# Optional: Gemini model for the AI features when Claude is not configured (default gemini-3.5-flash)
# GEMINI_AI_MODEL=gemini-3.5-flash

# Music library (royalty-free Creative Commons tracks from Jamendo). Optional; without it the Audio panel
# shows a setup hint. Get a free client id at https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Largest upload accepted by /api/transcribe, in MB (default 2048)
# MAX_UPLOAD_MB=2048

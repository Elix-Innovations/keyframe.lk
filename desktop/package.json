{
  "name": "keyframe-desktop",
  "productName": "Keyframe",
  "version": "1.0.2",
  "license": "MIT",
  "description": "Keyframe.lk video editor",
  "main": "main.js",
  "author": "Keyframe",
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "start": "electron .",
    "dist": "npm run prepare:app && electron-builder --mac dmg",
    "dist:win": "node scripts/prepare.mjs --win && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "lk.keyframe.desktop",
    "productName": "Keyframe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "aligner.js",
      "preload.js",
      "splash.html",
      "icon.png",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "build/web",
        "to": "web"
      },
      {
        "from": "build/server",
        "to": "server"
      },
      {
        "from": "build/bin",
        "to": "bin"
      },
      {
        "from": "build/pyroot",
        "to": "pyroot"
      }
    ],
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Install Keyframe"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Keyframe",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "resedit": "^1.7.2"
  },
  "overrides": {
    "minimatch@^9": "^11.0.1",
    "minimatch@^10": "^11.0.1"
  }
}
